    "vitest": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@typescript/typescript6": "6.0.2",
    "@wildshard/dev": "0.9.1",
    "npm-bin-deps": "2.2.0",
    "oxlint": "1.89.0",
    "playwright": "1.65.0",
