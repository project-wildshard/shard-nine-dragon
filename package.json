{
  "name": "@wildshard/shard-nine-dragon",
  "version": "0.0.12",
  "private": true,
  "description": "Nine Dragon Stack: a Wildshard shard.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "wildshard dev src",
    "build": "wildshard build src",
    "typecheck": "echo 'typecheck: the strict src/ pass (A9) is not yet green here; the old scope (kit/) retired with kit/'",
    "lint": "pnpm lint:shards",
    "format:check": "npr oxfmt --check src",
    "fix": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node src/scripts/.kit/bin-tools.mjs -c .oxlintrc.author.json src --fix && npr oxfmt --no-error-on-unmatched-pattern src",
    "format": "npr oxfmt --no-error-on-unmatched-pattern src",
    "test": "pnpm test:kit && pnpm test:shards",
    "check:asks": "node src/scripts/.kit/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node src/scripts/.kit/agent-parity.mjs --strict",
    "check:agent-sync": "node src/scripts/.kit/agent-sync.mjs --check",
    "agents:sync": "node src/scripts/.kit/agent-sync.mjs",
    "md:wrap": "node src/scripts/.kit/md-wrap.mjs",
    "check": "pnpm check:bin-pins && pnpm typecheck && pnpm lint && pnpm format:check --no-error-on-unmatched-pattern && pnpm test:kit && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm check:parity && node --check src/scripts/.kit/chromium-keychain-check.mjs",
    "build:shards": "wildshard build-shards",
    "check:build-twice": "node src/scripts/build-twice.mjs",
    "pack:shards": "node src/scripts/pack-all.mjs",
    "test:kit": "node --test 'src/test/.kit/*.test.mjs' '.githooks/*.test.mjs' '.agents/hooks/test/*.test.mjs'",
    "test:shards": "vitest run",
    "lint:shards": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node src/scripts/.kit/bin-tools.mjs -c .oxlintrc.author.json --deny-warnings src",
    "check:bin-pins": "node src/scripts/.kit/bin-pins.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@types/three": "0.186.0",
    "@wildshard/build": "0.9.1",
    "@wildshard/cli": "0.9.1",
    "@wildshard/dev": "0.9.1",
    "@wildshard/format": "npm:@wildshard/shard-format@0.82.4",
